{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "dist",
    "lib": ["es2023"],
    "target": "es2023",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/*.spec.ts"]
}
